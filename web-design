<script>(()=>{const mb=document.querySelector('.menu-btn'),nav=document.querySelector('.navlinks');mb.addEventListener('click',()=>{const o=nav.classList.toggle('open');mb.setAttribute('aria-expanded',String(o))});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open')));document.getElementById('year').textContent=new Date().getFullYear();const rs=document.querySelectorAll('.reveal');if('IntersectionObserver'in window){const ob=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');ob.unobserve(e.target)}}),{threshold:.08});rs.forEach(x=>ob.observe(x))}else rs.forEach(x=>x.classList.add('visible'));const f=document.getElementById('webForm'),m=document.getElementById('formMsg');f.addEventListener('submit',e=>{e.preventDefault();if(!f.checkValidity()){m.textContent='Please complete the required fields.';f.reportValidity();return}const v=id=>document.getElementById(id).value.trim();const subject='LOS Website enquiry - '+v('service')+' - '+v('business');const body=['Hello Faton,','','I would like to discuss '+v('service')+'.','','Name: '+v('name'),'Business: '+v('business'),'Email: '+v('email'),'','Details:',v('message'),'','Thanks,',v('name')].join('\n');m.textContent='Your email application is opening now.';location.href='mailto:fatoni.salihu@gmail.com?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body)})})();</script>
